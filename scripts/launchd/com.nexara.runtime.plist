<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nexara.runtime</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.12</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>nexara_prime.api:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/NEXARA/NEXARA-PRIME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/agentos/Library/Logs/nexara/runtime.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/agentos/Library/Logs/nexara/runtime.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/agentos</string>
        <key>PYTHONPATH</key>
        <string>/Volumes/NEXARA/NEXARA-PRIME/src:/Volumes/NEXARA/NEXARA-PRIME/.venv/lib/python3.12/site-packages</string>
        <key>NEXARA_MODEL_PROVIDER</key>
        <string>deepseek</string>
        <key>NEXARA_MOCK_MODEL</key>
        <string>false</string>
        <key>NEXARA_MODEL_ENDPOINT</key>
        <string>https://api.deepseek.com/v1</string>
        <key>NEXARA_MODEL_NAME</key>
        <string>deepseek-v4-pro</string>
        <key>NEXARA_MODEL_TIMEOUT</key>
        <string>120</string>
        <key>NEXARA_MAX_OUTPUT_TOKENS</key>
        <string>4096</string>
        <key>NEXARA_DB_PATH</key>
        <string>/Volumes/NEXARA/NEXARA-PRIME/runtime/nexara.db</string>
        <key>NEXARA_WORKSPACE_ROOT</key>
        <string>/Volumes/NEXARA/NEXARA-PRIME/workspace</string>
        <key>NEXARA_REPORT_ROOT</key>
        <string>/Volumes/NEXARA/NEXARA-PRIME/reports</string>
        <key>NEXARA_API_HOST</key>
        <string>127.0.0.1</string>
        <key>NEXARA_API_PORT</key>
        <string>8765</string>
    </dict>
</dict>
</plist>
