NEXARA_MODEL_PROVIDER=mock
NEXARA_MOCK_MODEL=true
NEXARA_MODEL_ENDPOINT=https://api.openai.com/v1
NEXARA_MODEL_NAME=gpt-4o-mini
NEXARA_LOCAL_MODEL_ENDPOINT=
# Multi-channel free-tier pool. Set NEXARA_MODEL_PROVIDER=pool to enable.
# Channels rotate with cooldown backoff + per-channel daily token ledger.
# ${VAR} api_key references resolve from the environment.
NEXARA_MODEL_POOL='[{"name":"ovh","endpoint":"https://oai.endpoints.kepler.ai.cloud.ovh.net/v1","model":"Qwen3-32B","priority":0,"anonymous":true},{"name":"kilo","endpoint":"https://api.kilo.ai/api/gateway","model":"kilo-auto/free","priority":1,"anonymous":true},{"name":"zai","endpoint":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4.6v-flash","api_key":"${ZAI_API_KEY}","priority":2}]'
ZAI_API_KEY=
NEXARA_DB_PATH=./runtime/nexara.db
NEXARA_WORKSPACE_ROOT=./workspace
NEXARA_REPORT_ROOT=./reports
NEXARA_API_HOST=127.0.0.1
NEXARA_API_PORT=8765
