    },
    {
      "tool_id": "tool.browser.extract",
      "category": "BROWSER",
      "capability_requirements": [
        "cap.browser.control"
      ],
      "sandbox_level": "CONTAINER",
      "adapter": "ToolRuntime.browser_extract"
    }
  ],
  "integration": {
    "existing": "ToolRuntime in src/nexara_prime/tools.py — adapter_reference maps to existing methods",
    "non_invasive": "Registry is additive. Existing ToolRuntime.method() calls unchanged. Registry adds discover+validate layer above."
  }
}