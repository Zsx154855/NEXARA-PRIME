      "src/nexara_prime/brain/reasoning_budget.py"
    ],
    "import_prohibition": [
      "brain/reasoning/ NEVER imports brain.db",
      "brain/reasoning/ NEVER imports brain/memory_controller.py directly (use interface)",
      "brain/reasoning/ NEVER imports runtime.py, evidence.py, evaluation.py",
      "brain/reasoning/ NEVER imports tools.py, model_gateway.py"
    ]
  },
  "module_specifications": {
    "REASON-01_kernel": {
      "file": "brain/reasoning/kernel.py",
      "class": "ReasoningKernel",
      "methods": {
        "reason": {
          "signature": "reason(mission: MissionContext, context: AssembledContext, constraints: list[str]) -> ReasoningResult",
          "description": "Execute full reasoning chain: assemble→think→decide→check. Returns result with trace."
        },
        "audit": {
          "signature": "audit(reasoning_id: str) -> ReasoningTrace",
          "description": "Return full step-by-step reasoning trace with evidence references."
        },
        "quantify_uncertainty": {
          "signature": "quantify_uncertainty(conclusion: str, evidence_weight: float) -> ConfidenceScore",
          "description": "Quantify uncertainty of a conclusion given evidence strength."
        }
      },
      "output": {
        "reasoning_id": "str",
        "reasoning_trace": "list[ReasoningStep]",
        "conclusion": "str",
        "confidence": "float (0.0-1.0)",
        "evidence_refs": "list[str]",
        "uncertainty": "UncertaintyReport",
        "self_check_passed": "bool",
        "alternatives": "list[AlternativeDecision]"
      }
    },
    "REASON-02_thought_process": {
      "file": "brain/reasoning/kernel.py (ThoughtProcessEngine inner class)",
      "class": "ThoughtProcessEngine",
      "methods": {
        "execute_chain": {
          "signature": "execute_chain(query: str, context: AssembledContext, chain_type: str = 'linear') -> list[ReasoningStep]",
          "description": "Execute reasoning chain: OBSERVE→CLASSIFY→DECOMPOSE→INFER→VALIDATE→SYNTHESIZE→REFLECT"
        }
      },
      "step_output": {
        "step_id": "str",
        "step_type": "str (OBSERVE/CLASSIFY/DECOMPOSE/INFER/VALIDATE/SYNTHESIZE/REFLECT)",
        "input_facts": "list[str]",
        "operation": "str (description of what this step does)",
        "output": "str (conclusion or intermediate result)",
        "confidence": "float",
        "evidence_refs": "list[str]"
      }
    },
    "REASON-03_context_assembly": {
      "file": "brain/reasoning/context_assembler.py",
      "class": "ContextAssembler",
      "methods": {
        "assemble": {
          "signature": "assemble(mission: MissionContext, memory: MemoryRetrievalAdapter) -> AssembledContext",
          "description": "6-step pipeline: extract→retrieve→past_decisions→preferences→dedup→bound"
        }
      },
      "hard_limits": {
        "max_items": 50,
        "max_tokens": 5000
      }
    },
    "REASON-04_memory_adapter": {
      "file": "brain/reasoning/context_assembler.py (MemoryRetrievalAdapter inner class)",
      "class": "MemoryRetrievalAdapter",
      "methods": {
        "retrieve": {
          "signature": "retrieve(query: str, strategy: str, top_k: int, min_confidence: float) -> list[MemoryItem]",
          "description": "Wraps MemoryController.rank_retrieve(). 5 strategies: broad_semantic, episodic_match, working_context, preference_bias, procedural_rules."
        }
      },
      "isolation_rule": "NEVER imports brain.db or any runtime module. Only calls MemoryController.rank_retrieve() through interface."
    },
    "REASON-05_decision_framework": {
      "file": "brain/reasoning/decision_framework.py",
      "class": "DecisionFramework",
      "methods": {
        "decide": {
          "signature": "decide(problem: ProblemFrame, options: list[DecisionOption], evidence: list[EvidenceItem], risk: RiskAssessment) -> Decision",
          "description": "6-step: Problem→Options→Evidence→Risk→Selection→Review"
        }
      },
      "output": {
        "decision": "str (selected option)",
        "reason": "str (rationale)",
        "evidence": "list[str] (evidence references)",
        "risk": "str (risk assessment)",
        "confidence": "float"
      }
    },
    "REASON-06_confidence": {
      "file": "brain/reasoning/confidence.py",
      "class": "ConfidenceEngine",
      "methods": {
        "evaluate": {
          "signature": "evaluate(evidence_strength: float, consistency: float, completeness: float, source_reliability: float, historical_accuracy: float) -> ConfidenceScore",
          "description": "5-factor weighted scoring. Weights MUST sum to 1.0."
        }
      },
      "weights": {
        "evidence_strength": 0.35,
        "consistency": 0.2,
        "completeness": 0.2,
        "source_reliability": 0.15,
        "historical_accuracy": 0.1
      }
    },
    "REASON-07_self_check": {
      "file": "brain/reasoning/self_check.py",
      "class": "SelfCheckValidator",
      "methods": {
        "validate": {
          "signature": "validate(trace: list[ReasoningStep]) -> SelfCheckResult",
          "description": "5 checks: consistency, completeness, evidence_coverage, calibration, circularity."
        }
      },
      "checks": [
        {
          "name": "consistency",
          "method": "Compare conclusion pairs for contradiction"
        },
        {
          "name": "completeness",
          "method": "Verify all step dependencies satisfied"
        },
        {
          "name": "evidence_coverage",
          "method": "All INFER/SYNTHESIZE steps have >=1 evidence_ref"
        },
        {
          "name": "calibration",
          "method": "No step confidence > evidence_strength + 0.3"
        },
        {
          "name": "circularity",
          "method": "No cycles in step dependency graph"
        }
      ]
    }
  },
