{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexara://contracts/nexara/reasoning/implementation_contract_v1.json",
  "title": "NEXARA Reasoning Kernel Implementation Scope Contract V1",
  "description": "Frozen implementation scope for Reasoning Kernel Phase 1. Defines exact files, interfaces, test requirements, and forbidden boundaries. ZERO runtime modification. Implementation starts only after Claude review PASS + human approval.",
  "frozen_at": "2026-07-27T18:00:00Z",
  "governed_by": "NSEC V2.1 Article 1, 8, 37, 45",
  "contract_type": "implementation_scope",
  "phase": "PHASE_REASONING_KERNEL_IMPLEMENTATION",
  "parent_design": "contracts/nexara/reasoning/NEXARA_REASONING_KERNEL_DESIGN_V1.json",
  "parent_component": "BRAIN-06: Reasoning Kernel",
  "version": "1.0.0",
  "mission_scope": {
    "objective": "Implement Reasoning Kernel — cognitive inference layer. 7 modules. ZERO runtime modification. Deterministic inference only (no model calls).",
    "what_is_implemented": [
      "REASON-01: Kernel API — reason(), audit(), quantify_uncertainty()",
      "REASON-02: Thought Process Engine — 7 step types (OBSERVE→CLASSIFY→DECOMPOSE→INFER→VALIDATE→SYNTHESIZE→REFLECT)",
      "REASON-03: Context Assembly — 6-step pipeline, bounded to 50 items / 5000 tokens",
      "REASON-04: Memory Retrieval Adapter — wraps MemoryController.rank_retrieve(), never imports brain.db",
      "REASON-05: Decision Framework — Problem→Options→Evidence→Risk→Selection→Review",
      "REASON-06: Confidence Engine — 5 factors (evidence_strength, consistency, completeness, source_reliability, historical_accuracy), weights sum 1.0",
      "REASON-07: Self Check Validator — 5 checks (consistency, completeness, evidence, calibration, circularity)"
    ],
    "what_is_explicitly_deferred": [
      "Model-call-based reasoning (Phase 3 — after confidence calibration data exists)",
      "DecisionMemory writes (depends on DecisionMemory implementation — Phase 2)",
      "Knowledge Graph integration (depends on KnowledgeGraph — Phase 2)",
      "Preference Model integration (depends on PreferenceModel — Phase 4)",
      "Evolution-driven reasoning improvement (Phase 5)",
      "UI for reasoning visualization"
    ]
  },
  "allowed_files": {
