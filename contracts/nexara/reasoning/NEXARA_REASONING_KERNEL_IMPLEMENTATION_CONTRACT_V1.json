      "contracts/nexara/NEXARA_PERSONAL_BRAIN_ARCHITECTURE_CONTRACT_V1.json"
    ],
    "read_only_reference": [
      "src/nexara_prime/brain/memory_controller.py (rank_retrieve() only)",
      "src/nexara_prime/brain/kernel.py (decide() integration point)",
      "src/nexara_prime/models.py (MemoryKind, RiskLevel types)"
    ],
    "untouchable_brain_files": [
      "src/nexara_prime/brain/kernel.py",
      "src/nexara_prime/brain/decision_engine.py",
      "src/nexara_prime/brain/context_engine.py",
      "src/nexara_prime/brain/memory_controller.py",
